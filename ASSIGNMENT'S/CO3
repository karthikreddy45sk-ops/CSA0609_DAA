# Q3: NORMAL AND KARATSUBA MULTIPLICATION
# ==================================================

def normal_multiply(a, b):
    return a * b


def karatsuba(x, y):

    if x < 10 or y < 10:
        return x * y

    n = max(len(str(x)), len(str(y)))
    half = n // 2

    power = 10 ** half

    a = x // power
    b = x % power

    c = y // power
    d = y % power

    ac = karatsuba(a, c)
    bd = karatsuba(b, d)

    ad_bc = karatsuba(a + b, c + d) - ac - bd

    return ac * (10 ** (2 * half)) + ad_bc * power + bd


