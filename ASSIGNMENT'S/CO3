# Q1 PART A: MAXIMUM AND MINIMUM
# ==================================================

def find_min_max(arr, low, high):

    if low == high:
        return arr[low], arr[low], 0

    if high == low + 1:
        if arr[low] < arr[high]:
            return arr[low], arr[high], 1
        else:
            return arr[high], arr[low], 1

    mid = (low + high) // 2

    min1, max1, c1 = find_min_max(arr, low, mid)
    min2, max2, c2 = find_min_max(arr, mid + 1, high)

    minimum = min(min1, min2)
    maximum = max(max1, max2)

    return minimum, maximum, c1 + c2 + 2


