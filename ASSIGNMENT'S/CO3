# ==================================================

def distance(p1, p2):

    return math.sqrt(
        (p1[0] - p2[0]) ** 2 +
        (p1[1] - p2[1]) ** 2
    )


def brute_force(points):

    minimum = float('inf')
    pair = None
    count = 0

    for i in range(len(points)):
        for j in range(i + 1, len(points)):

            count += 1
            d = distance(points[i], points[j])

            if d < minimum:
                minimum = d
                pair = (points[i], points[j])

    return pair, minimum, count


def divide_closest(points):

    count = [0]

    def solve(px):

        n = len(px)

        if n <= 3:

            best = float('inf')
            pair = None

            for i in range(n):
                for j in range(i + 1, n):

                    count[0] += 1
                    d = distance(px[i], px[j])

                    if d < best:
                        best = d
                        pair = (px[i], px[j])

            return pair, best

        mid = n // 2
        middle_x = px[mid][0]

        left_pair, left_d = solve(px[:mid])
        right_pair, right_d = solve(px[mid:])

        if left_d < right_d:
            best_pair, best = left_pair, left_d
        else:
            best_pair, best = right_pair, right_d

        strip = [
            p for p in px
            if abs(p[0] - middle_x) < best
        ]

        strip.sort(key=lambda p: p[1])

        for i in range(len(strip)):
            for j in range(i + 1, len(strip)):

                if strip[j][1] - strip[i][1] >= best:
                    break

                count[0] += 1
                d = distance(strip[i], strip[j])

                if d < best:
                    best = d
                    best_pair = (strip[i], strip[j])

        return best_pair, best

    points = sorted(points, key=lambda p: p[0])

    pair, minimum = solve(points)

    return pair, minimum, count[0]


