# Q6 PART B: MEET-IN-THE-MIDDLE
# ==================================================

def subset_sums(arr):

    result = []

    for r in range(len(arr) + 1):

        for items in combinations(arr, r):
            result.append(sum(items))

    return result


def meet_in_middle(arr, target):

    mid = len(arr) // 2

    left = arr[:mid]
    right = arr[mid:]

    left_sums = subset_sums(left)
    right_sums = set(subset_sums(right))

    for value in left_sums:

        required = target - value

        if required in right_sums:
            return True

    return False


