# Q1 PART B: BINARY SEARCH
# ==================================================

def binary_search(arr, target):

    low = 0
    high = len(arr) - 1
    count = 0

    while low <= high:

        mid = (low + high) // 2
        count += 1

        if arr[mid] == target:
            return mid, count

        elif target < arr[mid]:
            high = mid - 1

        else:
            low = mid + 1

    return -1, count


