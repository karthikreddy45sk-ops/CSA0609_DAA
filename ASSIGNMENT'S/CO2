# Q7 - REDESIGN: SEQUENTIAL SEARCH TO HASH TABLE
# =====================================================

def hash_search(tool_table, target):
    # Dictionary lookup uses the Tool ID as the key
    return tool_table.get(target, None)


print("\n========== Q7: REDESIGN USING HASH TABLE ==========")

# Original Sequential Search
target = "T-104"

result, old_count = sequential_search(tools, target)

print("Original Sequential Search:")
print("Found:", result)
print("Comparisons:", old_count)

# Redesigned Hash Table
tool_table = {}

for record in tools:
    tool_table[record["Tool ID"]] = record

result = hash_search(tool_table, target)

print("\nRedesigned Hash Table Search:")
print("Found:", result)
print("Lookup Operations: 1 (one dictionary lookup)")

