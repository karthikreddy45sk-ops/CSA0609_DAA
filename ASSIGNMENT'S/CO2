# =====================================================
# Q3 - BRUTE-FORCE STRING MATCHING
# =====================================================

def string_matching(text, pattern):
    comparisons = 0
    positions = []

    n = len(text)
    m = len(pattern)

    for i in range(n - m + 1):
        j = 0

        while j < m:
            comparisons += 1

            if text[i + j] != pattern[j]:
                break

            j += 1

        if j == m:
            positions.append(i)

    return positions, comparisons


