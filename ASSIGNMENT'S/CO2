# =====================================================
# Q1 - SELECTION SORT, BUBBLE SORT AND INSERTION SORT
# =====================================================

def selection_sort(arr):
    a = arr.copy()
    comparisons = 0
    swaps = 0

    for i in range(len(a)):
        minimum = i

        for j in range(i + 1, len(a)):
            comparisons += 1
            if a[j] < a[minimum]:
                minimum = j

        if minimum != i:
            a[i], a[minimum] = a[minimum], a[i]
            swaps += 1

    return a, comparisons, swaps


def bubble_sort(arr):
    a = arr.copy()
    comparisons = 0
    swaps = 0

    for i in range(len(a)):
        changed = False

        for j in range(0, len(a) - i - 1):
            comparisons += 1

            if a[j] > a[j + 1]:
                a[j], a[j + 1] = a[j + 1], a[j]
                swaps += 1
                changed = True

        if not changed:
            break

    return a, comparisons, swaps


def insertion_sort(arr):
    a = arr.copy()
    comparisons = 0
    movements = 0

    for i in range(1, len(a)):
        key = a[i]
        j = i - 1

        while j >= 0:
            comparisons += 1

            if a[j] > key:
                a[j + 1] = a[j]
                movements += 1
                j -= 1
            else:
                break

        a[j + 1] = key

    return a, comparisons, movements


