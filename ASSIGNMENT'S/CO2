    positions, count = string_matching(text, pattern)

    print("\nText:", text)
    print("Pattern:", pattern)
    print("Matching Positions:", positions)
    print("Character Comparisons:", count)


# =====================================================
# Q4 - BRUTE-FORCE CLOSEST PAIR
# =====================================================

def closest_pair(points):
    minimum_distance = float("inf")
    closest = None
    comparisons = 0

    for i in range(len(points)):
        for j in range(i + 1, len(points)):
            comparisons += 1

            x1, y1 = points[i]
            x2, y2 = points[j]

            distance = math.sqrt(
                (x2 - x1) ** 2 + (y2 - y1) ** 2
            )

            if distance < minimum_distance:
                minimum_distance = distance
                closest = (points[i], points[j])

    return closest, minimum_distance, comparisons


