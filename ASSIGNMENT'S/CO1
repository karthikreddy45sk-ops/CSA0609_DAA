# 1. ITERATIVE SEQUENTIAL SEARCH
def sequential_search(records, target):
    comparisons = 0

    for i in range(len(records)):
        comparisons += 1

        if records[i] == target:
            return i, comparisons

    return -1, comparisons


# 2. RECURSIVE BINARY SEARCH
def binary_search(records, target, low, high):
    if low > high:
        return -1, 0

    mid = (low + high) // 2
    comparisons = 1

    if records[mid] == target:
        return mid, comparisons

    if target < records[mid]:
        position, count = binary_search(
            records, target, low, mid - 1
        )
    else:
        position, count = binary_search(
            records, target, mid + 1, high
        )

    return position, comparisons + count


# 3. HASH TABLE SEARCH
def hash_table_search(student_table, target):
    # One dictionary lookup operation
    result = student_table.get(target, None)

    if result is not None:
        return result, 1

    return -1, 1


