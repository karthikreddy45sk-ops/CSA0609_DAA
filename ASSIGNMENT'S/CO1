print("\n========== TASK 8 AND 9: EXPERIMENTS ==========")

sizes = [1000, 10000, 100000, 1000000]

for n in sizes:

    print("\n----------------------------------")
    print("Number of Student Records:", n)

    # Generate registration numbers
    records = list(range(1, n + 1))

    # Search for the last registration number
    target = n

    # ---------------------------------
    # Sequential Search
    # ---------------------------------

    start = time.perf_counter()

    position, comparisons = sequential_search(
        records, target
    )

    sequential_time = time.perf_counter() - start

    print("\nSequential Search:")
    print("Position:", position)
    print("Comparisons:", comparisons)
    print("Execution Time:",
          round(sequential_time, 6), "seconds")

    # ---------------------------------
    # Binary Search
    # ---------------------------------

    # Preprocessing: sorting the records
    start = time.perf_counter()

    sorted_records = sorted(records)

    sorting_time = time.perf_counter() - start

    start = time.perf_counter()

    position, comparisons = binary_search(
        sorted_records,
        target,
        0,
        len(sorted_records) - 1
    )

    binary_time = time.perf_counter() - start

    print("\nRecursive Binary Search:")
    print("Position:", position)
    print("Comparisons:", comparisons)
    print("Sorting Time:", round(sorting_time, 6), "seconds")
    print("Search Time:", round(binary_time, 6), "seconds")

    # ---------------------------------
    # Hash Table Search
    # ---------------------------------

    # Preprocessing: building the hash table
    start = time.perf_counter()

    student_table = {
        registration_number: registration_number
        for registration_number in records
    }

    hash_build_time = time.perf_counter() - start

    start = time.perf_counter()

    position, operations = hash_table_search(
        student_table, target
    )

    hash_time = time.perf_counter() - start

    print("\nHash Table Search:")
    print("Position:", position)
    print("Lookup Operations:", operations)
    print("Hash Table Build Time:",
          round(hash_build_time, 6), "seconds")
    print("Search Time:", round(hash_time, 6), "seconds")


